  m_Script: {fileID: 11500000, guid: cde939564cab4924aa400c211a29d387, type: 3}
  m_Name: Interlude_Chapter4
  m_EditorClassIdentifier: Assembly-CSharp::Orasyon.Story.StoryScript
  title: Chapter 4 Complete
  subtitle: The Moon Goes Dark
  background: {fileID: 2800000, guid: 6149edabf493ece4abb2373cafa28218, type: 3}
  lines:
  - speaker: 0
    text: The Manananggal's shriek fades into the dawn... but the dawn does not come.
    flash: 0
    changeBackground: {fileID: 0}
    lolaOnStage: 0
    lolaPose: 0
  - speaker: 1
    text: Lola? The sky is getting darker, not lighter. The moon... something is
      eating it.
    flash: 0
    changeBackground: {fileID: 0}
    lolaOnStage: 0
    lolaPose: 0
  - speaker: 2
    text: The Bakunawa. The great serpent of the sea. It swallows the moon whenever
      the world forgets to make noise.
    flash: 0
    changeBackground: {fileID: 0}
    lolaOnStage: 0
    lolaPose: 0
  - speaker: 1
    text: Forget to make noise? What do you mean?
    flash: 0
    changeBackground: {fileID: 0}
    lolaOnStage: 0
    lolaPose: 0
  - speaker: 2
    text: In the old days, the people banged pots and gongs until the serpent spat
      the moon back out. Long words do the same, apo. Ring them like a gong.
    flash: 0
    changeBackground: {fileID: 0}
    lolaOnStage: 0
    lolaPose: 0
  - speaker: 1
    text: Then I will ring the longest words I know.
    flash: 0
    changeBackground: {fileID: 0}
    lolaOnStage: 0
    lolaPose: 0
  - speaker: 2
    text: Go. The whole archipelago is watching the sky.
    flash: 0
    changeBackground: {fileID: 0}
    lolaOnStage: 0
    lolaPose: 0
  - speaker: 0
    text: The book blazes, and the sea opens beneath a darkening moon.
    flash: 1
    changeBackground: {fileID: 2800000, guid: 3808d6a0ae88fce4b896dceafebcfe7c, type: 3}
    lolaOnStage: 0
    lolaPose: 0
  nextScene: Level5
  creditsText: 
